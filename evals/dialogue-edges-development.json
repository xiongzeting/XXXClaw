      ],
      "fixture": "fixtures/dialogue-campaign/atomic_batch_update",
      "session_mode": "shared",
      "phases": [
        {
          "id": "turn1",
          "prompt": "app.py 的 apply_updates(state, updates) 要批量更新库存：updates 是 (商品名, 库存增量) 列表。任何商品最终库存不能为负，未知商品视为 0。出错要抛 ValueError，整个 state 保持原样；成功则原地提交全部更新。只改 app.py。"
        },
        {
          "id": "turn2",
          "prompt": "补充：同一商品可能出现多次，按列表顺序应用，每一步不能为负；不要只验证最后的总和。函数成功时返回 None。"
        }
      ],
      "checks": [
        {
          "type": "command",
          "command": [
            "python",
            "-c",
            "import pathlib,subprocess,sys; args=['docker','run','--rm','--network','none','--read-only','--cap-drop','ALL','--security-opt','no-new-privileges','--pids-limit','64','--memory','256m','--cpus','1','--tmpfs','/tmp:rw,noexec,nosuid,size=16m','--mount','type=bind,source='+str(pathlib.Path.cwd())+',target=/workspace,readonly','-w','/workspace','-e','PYTHONDONTWRITEBYTECODE=1','miniclaw-runtime:py313-bench','python','-c',\"from app import apply_updates as f\\ns={'a':3,'b':2}\\ntry:f(s,[('a',1),('b',-3)])\\nexcept ValueError:pass\\nelse:raise AssertionError('negative accepted')\\nassert s=={'a':3,'b':2}\\ntry:f(s,[('a',-4),('a',4)])\\nexcept ValueError:pass\\nelse:raise AssertionError('transient negative accepted')\\nassert s=={'a':3,'b':2}\\nassert f(s,[('a',-2),('c',4)]) is None\\nassert s=={'a':1,'b':2,'c':4}\"]; result=subprocess.run(args,timeout=45); sys.exit(result.returncode)"
          ],
          "exit_code": 0,
          "timeout_seconds": 60,
          "dimension": "outcome"
        },
