      "phases": [
        {
          "id": "turn1",
          "prompt": "实现 report.py 的命令行接口，调用形式必须是 python report.py INPUT_FILE OUTPUT_FILE，两个参数都是文件路径，绝不是把JSON数组直接放参数里。读取 INPUT_FILE 的整数数组，将 count、sum、average 写入 OUTPUT_FILE 的JSON对象；空数组 average 为 JSON null。只改 report.py，并实际验证命令行。"
        }
      ],
      "checks": [
        {
          "type": "command",
          "command": [
            "python",
            "-c",
            "import pathlib,subprocess,sys; args=['docker','run','--rm','--network','none','--read-only','--cap-drop','ALL','--security-opt','no-new-privileges','--pids-limit','64','--memory','256m','--cpus','1','--tmpfs','/tmp:rw,noexec,nosuid,size=16m','--mount','type=bind,source='+str(pathlib.Path.cwd())+',target=/workspace,readonly','-w','/workspace','-e','PYTHONDONTWRITEBYTECODE=1','miniclaw-runtime:py313-bench','python','-c','import json,subprocess,tempfile\\nfrom pathlib import Path\\nwith tempfile.TemporaryDirectory() as d:\\n p=Path(d)\\n for values in [[2,4,6],[],[-3,0,3]]:\\n  (p/\"in.json\").write_text(json.dumps(values))\\n  subprocess.run([\"python\",\"report.py\",str(p/\"in.json\"),str(p/\"out.json\")],check=True)\\n  assert json.loads((p/\"out.json\").read_text())=={\"count\":len(values),\"sum\":sum(values),\"average\":sum(values)/len(values) if values else None}']; result=subprocess.run(args,timeout=45); sys.exit(result.returncode)"
