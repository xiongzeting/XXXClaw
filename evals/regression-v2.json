{
  "version": 1,
  "name": "failure-regression-v2",
  "environment": {
    "MINICLAW_SANDBOX": "docker:miniclaw-runtime:py313-bench",
    "MINICLAW_WORKSPACE_MODE": "direct",
    "MINICLAW_APPROVAL_POLICY": "allow",
    "MINICLAW_GOAL_JUDGE_ENABLED": "false"
  },
  "cases": [
    {
      "id": "dialogue_chain_after_handover",
      "category": "memory-multihop",
      "capabilities": [
        "user_dialogue",
        "memory-multihop"
      ],
      "fixture": "fixtures/dialogue-campaign/chain_after_handover",
      "session_mode": "isolated",
      "phases": [
        {
          "id": "turn1",
          "prompt": "记住关联：组件 render-core 属于包 ui-kit；ui-kit 属于团队 Canvas；Canvas 联系人 Rin。"
        },
        {
          "id": "turn2",
          "prompt": "再记另一条：draw-core 属于 plot-kit；plot-kit 属于团队 Charts；Charts 联系人 Jan。"
        },
        {
          "id": "turn3",
          "prompt": "ui-kit 已正式转交 Charts 团队，Canvas 仍由 Rin 联系，Charts 仍由 Jan 联系。请更新包归属。"
        },
        {
          "id": "turn4",
          "prompt": "现在 render-core 出问题应该联系哪支团队和谁？JSON：team、contact。"
        }
      ],
      "checks": [
        {
          "type": "final_json",
          "fields": {
            "team": "Charts",
            "contact": "Jan"
          },
          "dimension": "outcome"
        }
      ],
      "timeout_seconds": 480,
      "source": {
        "kind": "synthetic_user_dialogue",
        "campaign": "dialogue-20260905",
        "track": "development",
        "origin": "hand-authored realistic scenario",
        "oracle": "independent expected fields or isolated hidden tests",
        "replaces_case": "memory_multihop_failure",
        "replacement_reason": "Natural multi-turn task and stronger independent outcome oracle"
      }
    },
    {
      "id": "dialogue_preference_exception_scope",
      "category": "memory-scope",
      "capabilities": [
        "user_dialogue",
        "memory-scope"
      ],
      "fixture": "fixtures/dialogue-campaign/preference_exception_scope",
      "session_mode": "isolated",
      "phases": [
        {
          "id": "turn1",
          "prompt": "记住：我的通用示例偏好 Python，但维护 Sol 项目时必须用 TypeScript，维护旧 Moon 项目时用 Java。"
        },
        {
          "id": "turn2",
          "prompt": "Sol 项目改名为 Solstice，代码语言要求不变。请更新这个项目例外，通用偏好和 Moon 都不变。"
        },
        {
          "id": "turn3",
          "prompt": "新开一个没有其他约定的练习项目，以及 Solstice 和 Moon，各用什么示例语言？JSON 字段 default、Solstice、Moon。"
        }
      ],
      "checks": [
        {
          "type": "final_json",
          "fields": {
            "default": "Python",
            "Solstice": "TypeScript",
            "Moon": "Java"
          },
          "dimension": "outcome"
        }
      ],
      "timeout_seconds": 480,
      "source": {
        "kind": "synthetic_user_dialogue",
        "campaign": "dialogue-20260905",
        "track": "development",
        "origin": "hand-authored realistic scenario",
        "oracle": "independent expected fields or isolated hidden tests",
        "replaces_case": "memory_preference_failure",
        "replacement_reason": "Natural multi-turn task and stronger independent outcome oracle"
      }
    },
    {
      "id": "tool_evidence_synthesis_failure",
      "category": "tool-evidence",
      "capabilities": [
        "tool_evidence",
        "result_correctness",
        "trace_process"
      ],
      "fixture": "fixtures/evidence-synthesis",
      "source": {
        "benchmark": "PointFiveLabs/ai-efficiency-benchmark",
        "case_id": "long_synth_incident",
        "failure_signature": "benchmark:long_session:missing_answer_part"
      },
      "prompt": "Read-only incident investigation: inspect logs/prod_incident.log, correlate the request-id cascade, inspect logs/api_small.log, and locate the defining file of the TypeError function. Reply exactly in this shape: F1=<code> F2=<code> F3=<reason> REQ=<id> FILE=<path>.",
      "checks": [
        {
          "type": "final_contains",
          "text": "E_DISK_FULL_9314",
          "dimension": "outcome"
        },
        {
          "type": "final_contains",
          "text": "E_TOKEN_CASCADE_2201",
          "dimension": "outcome"
        },
        {
          "type": "final_contains",
          "text": "OOMKilled",
          "dimension": "outcome"
        },
        {
          "type": "final_contains",
          "text": "rCORR777",
          "dimension": "outcome"
        },
        {
          "type": "final_contains",
          "text": "libs/util/keys.py",
          "dimension": "outcome"
        },
        {
          "type": "trace_event",
          "event": "tool.call",
          "where": {
            "data.tool_name": "grep",
            "data.status": "success"
          },
          "dimension": "process"
        }
      ],
      "budgets": {
        "max_total_tokens": 18000,
        "max_agent_model_requests": 7,
        "max_tool_calls": 10,
        "max_duration_seconds": 360
      }
    },
    {
      "id": "dialogue_rollback_after_verify_failure",
      "category": "procedural-reasoning",
      "capabilities": [
        "user_dialogue",
        "procedural-reasoning"
      ],
      "fixture": "fixtures/dialogue-campaign/rollback_after_verify_failure",
      "session_mode": "shared",
      "phases": [
        {
          "id": "turn1",
          "prompt": "按 runbook.md 和执行记录确定下一步，不要真的操作。"
        },
        {
          "id": "turn2",
          "prompt": "JSON：next_step、may_resume。restore 执行结束并不等于恢复验收通过。"
        }
