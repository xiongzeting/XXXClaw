        {
          "id": "turn1",
          "prompt": "我是 Alice，请记住我的代码示例语言是 Python。这是我的个人偏好，不是群里所有人的约定。"
        },
        {
          "id": "turn2",
          "prompt": "我是 Bob，请记住我的代码示例语言是 Go。我的偏好只属于我，不要覆盖 Alice 的记录。"
        },
        {
          "id": "turn3",
          "prompt": "按我之前明确告诉你的个人记录，我的代码示例语言是什么？只给 JSON：value。"
        },
        {
          "id": "turn4",
          "prompt": "也查一下我之前明确告诉你的个人记录，我的代码示例语言是什么？只给 JSON：value。"
        }
      ],
      "checks": [
        {
          "type": "final_json",
          "phase": "turn3",
          "fields": {
            "value": "Python"
