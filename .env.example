# Default OpenAI-compatible provider
MINICLAW_PROVIDER=primary
MINICLAW_PRIMARY_API_KEY=
MINICLAW_PRIMARY_BASE_URL=https://ai.zxcoding.top/v1
MINICLAW_PRIMARY_MODEL=gpt-5.6-luna

# Model limits. Override these when the provider publishes different values.
MINICLAW_CONTEXT_WINDOW=128000
MINICLAW_MAX_OUTPUT_TOKENS=8192

# Optional DeepSeek provider
MINICLAW_DEEPSEEK_API_KEY=
MINICLAW_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
MINICLAW_DEEPSEEK_MODEL=deepseek-v4-flash

# Native SSE model transport. MINICLAW_LLM_TIMEOUT remains a total-timeout alias.
MINICLAW_LLM_TOTAL_TIMEOUT=120
MINICLAW_LLM_CONNECT_TIMEOUT=10
MINICLAW_LLM_FIRST_TOKEN_TIMEOUT=60
MINICLAW_LLM_IDLE_TIMEOUT=30
MINICLAW_LLM_MAX_RETRIES=2
MINICLAW_LLM_RETRY_BASE_SECONDS=0.5
MINICLAW_LLM_RETRY_MAX_SECONDS=8
MINICLAW_LLM_RETRY_JITTER_RATIO=0.2
# Ordered provider:model routes used only after the current route is exhausted.
# Provider-specific API keys must be configured; requests are never silently sent elsewhere.
MINICLAW_LLM_FALLBACKS=

# Optional model pricing used by Trace cost metrics (USD per million tokens).
# Leave at 0 when the provider price is unknown; Trace will report token usage with zero estimated cost.
MINICLAW_PRICE_INPUT_PER_MILLION=0
MINICLAW_PRICE_OUTPUT_PER_MILLION=0
MINICLAW_PRICE_CACHED_INPUT_PER_MILLION=0

# Feishu long connection (requires installation with the feishu extra).
MINICLAW_FEISHU_APP_ID=
MINICLAW_FEISHU_APP_SECRET=
MINICLAW_FEISHU_SESSION_SCOPE=thread

# Evaluation-oriented progressive compaction thresholds for the 128k profile.
# If you configure a smaller model window, remove these explicit overrides to use
# automatic safe scaling, or lower all four watermarks together.
MINICLAW_COMPACTION_ENABLED=true
MINICLAW_COMPACTION_TARGET_TOKENS=30000
MINICLAW_COMPACTION_KEEP_RECENT_TOKENS=20000
MINICLAW_COMPACTION_SOFT_TRIGGER_TOKENS=80000
MINICLAW_COMPACTION_HARD_TRIGGER_TOKENS=100000
MINICLAW_COMPACTION_RESERVE_TOKENS=12800
MINICLAW_PROGRESSIVE_COMPACTION_ENABLED=true
MINICLAW_CONTEXT_ARTIFACT_THRESHOLD_BYTES=16384
MINICLAW_CONTEXT_ARTIFACT_PREVIEW_CHARS=4000
MINICLAW_CONTEXT_DETERMINISTIC_SEMANTIC_TOKENS=4500

# Optional local Bi-Encoder used for semantic vector recall before RRF.
# Runtime never downloads the model automatically. If the dependency or local
# cache is missing, retrieval records the reason and falls back to LocalHash.
MINICLAW_MEMORY_VECTOR_ENABLED=true
MINICLAW_MEMORY_VECTOR_MODEL=BAAI/bge-m3
MINICLAW_MEMORY_VECTOR_BATCH_SIZE=8
MINICLAW_MEMORY_VECTOR_DEVICE=auto
MINICLAW_MEMORY_VECTOR_QUERY_PREFIX=
MINICLAW_MEMORY_VECTOR_DOCUMENT_PREFIX=
# After the first synchronization, a covered document scope is searched from
# the persistent FAISS index and only the new query vector is loaded/encoded.
# Diagnostics expose ann_vector_source=persistent-index or synchronized-documents.
MINICLAW_MEMORY_ANN_ENABLED=true
MINICLAW_MEMORY_ANN_HNSW_M=32
MINICLAW_MEMORY_ANN_EF_SEARCH=96
MINICLAW_MEMORY_EXACT_WEIGHT=0.36

# Optional local Cross-Encoder rerank after BM25 + vector + RRF recall.
# Runtime never downloads the model automatically; install the rerank extra and
# place the named model in the local Hugging Face cache before enabling it.
MINICLAW_MEMORY_CROSS_ENCODER_ENABLED=true
MINICLAW_MEMORY_CROSS_ENCODER_MODEL=BAAI/bge-reranker-v2-m3
MINICLAW_MEMORY_CROSS_ENCODER_CANDIDATES=48
MINICLAW_MEMORY_CROSS_ENCODER_WEIGHT=0.70
MINICLAW_MEMORY_CROSS_ENCODER_BATCH_SIZE=4
MINICLAW_MEMORY_CROSS_ENCODER_MAX_LENGTH=512
MINICLAW_MEMORY_CROSS_ENCODER_DEVICE=auto
MINICLAW_MEMORY_CONSOLIDATION_ENABLED=false
MINICLAW_MEMORY_CONSOLIDATION_MAX_INPUT_CHARS=24000
MINICLAW_MEMORY_MIN_FACT_CONFIDENCE=0.90
MINICLAW_MEMORY_MIN_PROCEDURE_CONFIDENCE=0.95

# Persistent Goal supervision.
MINICLAW_GOAL_MAX_ATTEMPTS=20
MINICLAW_GOAL_MAX_DURATION_SECONDS=14400
MINICLAW_GOAL_MAX_COST_USD=10
MINICLAW_GOAL_JUDGE_ENABLED=false
MINICLAW_GOAL_JUDGE_MODEL=
MINICLAW_GOAL_JUDGE_TIMEOUT=60

# Tool runtime. Docker + Direct is the default. Docker only contains bash;
# read/write/edit/grep continue through the guarded host-side workspace API.
MINICLAW_SANDBOX=docker:miniclaw-runtime:py311
MINICLAW_WORKSPACE_MODE=direct
MINICLAW_DOCKER_IMAGE=miniclaw-runtime:py311
MINICLAW_DOCKER_CPUS=1
MINICLAW_DOCKER_MEMORY_MB=1024
MINICLAW_DOCKER_PIDS_LIMIT=256
MINICLAW_DOCKER_NETWORK=none
MINICLAW_DOCKER_TMPFS_MB=128
MINICLAW_SNAPSHOT_MAX_MB=512
MINICLAW_SNAPSHOT_MAX_FILES=50000
MINICLAW_COMMAND_TIMEOUT_SECONDS=120
MINICLAW_COMMAND_MAX_TIMEOUT_SECONDS=900
MINICLAW_COMMAND_MAX_CAPTURE_MB=10

# Dangerous-operation approval.
# ask pauses risky tools for CLI/Feishu approval; deny fails closed; allow records and proceeds.
MINICLAW_APPROVAL_POLICY=ask
MINICLAW_APPROVAL_TIMEOUT_SECONDS=300
# Optional path to a project approval JSON file. Default: <workspace>/.miniclaw/approval.json
MINICLAW_APPROVAL_CONFIG=

# Layered project instructions. MiniClaw loads one of AGENTS.md/AGENTS.MD/CLAUDE.md/CLAUDE.MD
# from each active scope. The default global directory is ~/.miniclaw.
MINICLAW_INSTRUCTIONS_ENABLED=true
MINICLAW_INSTRUCTIONS_TOKEN_BUDGET=12000
# Optional path-list override (use the operating system path separator).
MINICLAW_AGENT_DIRS=
