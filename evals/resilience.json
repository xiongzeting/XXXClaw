{
  "version": 1,
  "name": "system-resilience",
  "environment": {
    "MINICLAW_APPROVAL_POLICY": "allow",
    "MINICLAW_GOAL_JUDGE_ENABLED": "false"
  },
  "coverage": {
    "dimensions": ["outcome", "process", "efficiency", "safety", "reliability"],
    "capabilities": [
      "progressive_compaction",
      "model_retry",
      "provider_fallback",
      "network_recovery",
      "approval_ask",
      "approval_timeout",
      "end_to_end_cancellation",
      "goal_restart_resume"
    ]
  },
  "cases": [
    {
      "id": "progressive_compaction_all_layers",
      "category": "compaction",
      "capabilities": ["progressive_compaction", "artifact_recovery", "trace_process"],
      "fixture": "fixtures/compaction",
      "session_mode": "shared",
      "timeout_seconds": 600,
      "environment": {
        "MINICLAW_SANDBOX": "host",
        "MINICLAW_CONTEXT_WINDOW": "16000",
        "MINICLAW_MAX_OUTPUT_TOKENS": "1024",
        "MINICLAW_COMPACTION_ENABLED": "true",
        "MINICLAW_PROGRESSIVE_COMPACTION_ENABLED": "true",
        "MINICLAW_COMPACTION_RESERVE_TOKENS": "1024",
        "MINICLAW_COMPACTION_SOFT_TRIGGER_TOKENS": "3000",
        "MINICLAW_COMPACTION_HARD_TRIGGER_TOKENS": "4000",
        "MINICLAW_COMPACTION_TARGET_TOKENS": "1800",
        "MINICLAW_COMPACTION_KEEP_RECENT_TOKENS": "700",
        "MINICLAW_CONTEXT_ARTIFACT_THRESHOLD_BYTES": "8192",
        "MINICLAW_CONTEXT_ARTIFACT_PREVIEW_CHARS": "1000",
        "MINICLAW_CONTEXT_DETERMINISTIC_SEMANTIC_TOKENS": "100",
        "MINICLAW_MEMORY_CONSOLIDATION_ENABLED": "false"
      },
      "phases": [
        {
          "id": "produce",
          "prompt": "Use bash three times, once for each exact command: `python emit.py large`, `python emit.py medium-a`, and `python emit.py medium-b`. Inspect the returned evidence and then reply with the three marker names. Do not read emit.py."
        },
        {
          "id": "recover",
          "prompt": "Read question.txt and answer it using the earlier tool evidence. Output only the requested marker."
        }
      ],
      "checks": [
        {"type": "final_contains", "phase": "recover", "text": "ARCHIVE-RECOVERY-731", "dimension": "outcome"},
        {"type": "metric", "name": "live_tool_artifacts", "min": 1, "dimension": "process"},
        {"type": "metric", "name": "archived_tool_artifacts", "min": 1, "dimension": "process"},
        {"type": "metric", "name": "history_archives", "min": 1, "dimension": "process"},
        {"type": "metric", "name": "model_summary_compactions", "min": 1, "dimension": "process"},
        {"type": "trace_sequence", "sequence": [
          {"event": "tool.call", "where": {"data.tool_name": "bash", "data.status": "success"}},
          {"event": "compaction.started"},
          {"event": "compaction.completed"}
        ], "dimension": "process"}
      ],
      "budgets": {
        "max_total_tokens": 30000,
        "max_agent_model_requests": 12,
        "max_tool_calls": 10,
        "min_compactions": 1,
        "min_compaction_tokens_saved": 1,
        "min_live_tool_artifacts": 1,
        "min_archived_tool_artifacts": 1,
        "min_history_archives": 1,
        "min_model_summary_compactions": 1,
        "max_wall_seconds": 600
      }
    },
    {
      "id": "model_429_retry_recovers",
      "category": "model-resilience",
      "capabilities": ["model_retry", "fault_injection", "reliability_repeat"],
      "repetitions": 2,
      "min_pass_rate": 1.0,
      "timeout_seconds": 300,
      "environment": {
        "MINICLAW_SANDBOX": "host",
        "MINICLAW_LLM_MAX_RETRIES": "1",
        "MINICLAW_LLM_RETRY_BASE_SECONDS": "0.01",
        "MINICLAW_LLM_RETRY_MAX_SECONDS": "0.01",
        "MINICLAW_LLM_RETRY_JITTER_RATIO": "0",
        "MINICLAW_MEMORY_CONSOLIDATION_ENABLED": "false"
      },
      "phases": [
        {
          "id": "main",
          "prompt": "Reply exactly RECOVERED-429 and do not call tools.",
          "control": {
            "inject_http_statuses": [429],
            "inject_retry_after_seconds": 0
          }
        }
      ],
      "checks": [
        {"type": "final_normalized_equals", "text": "RECOVERED-429", "dimension": "outcome"},
        {"type": "trace_event", "event": "model.transport", "where": {"data.phase": "retry_scheduled"}, "dimension": "process"},
        {"type": "trace_event", "event": "model.request", "where_min": {"data.retries": 1}, "dimension": "reliability"},
        {"type": "metric", "name": "model_errors", "equals": 0, "dimension": "reliability"}
      ],
      "budgets": {
        "max_total_tokens": 8000,
        "max_agent_model_requests": 2,
        "max_model_retries": 1,
        "max_model_errors": 0,
        "max_wall_seconds": 300
      }
    },
    {
      "id": "model_network_disconnect_recovers",
      "category": "model-resilience",
      "capabilities": ["network_recovery", "fault_injection"],
      "timeout_seconds": 300,
      "environment": {
        "MINICLAW_SANDBOX": "host",
        "MINICLAW_LLM_MAX_RETRIES": "1",
        "MINICLAW_LLM_RETRY_BASE_SECONDS": "0.01",
        "MINICLAW_LLM_RETRY_MAX_SECONDS": "0.01",
        "MINICLAW_LLM_RETRY_JITTER_RATIO": "0",
        "MINICLAW_MEMORY_CONSOLIDATION_ENABLED": "false"
      },
      "phases": [
        {
          "id": "main",
          "prompt": "Reply exactly NETWORK-RECOVERED and do not call tools.",
          "control": {
            "inject_network_disconnects": 1,
            "mock_success_text": "NETWORK-RECOVERED"
          }
        }
      ],
      "checks": [
        {"type": "final_normalized_equals", "text": "NETWORK-RECOVERED", "dimension": "outcome"},
        {"type": "trace_event", "event": "model.transport", "where": {"data.phase": "retry_scheduled"}, "dimension": "process"},
        {"type": "metric", "name": "model_retries", "equals": 1, "dimension": "reliability"}
      ],
      "budgets": {"max_total_tokens": 5000, "max_agent_model_requests": 1, "max_model_retries": 1, "max_model_errors": 0, "max_wall_seconds": 300}
    },
    {
      "id": "provider_fallback_after_primary_failure",
      "category": "model-resilience",
      "capabilities": ["provider_fallback", "fault_injection"],
      "timeout_seconds": 120,
      "environment": {
        "MINICLAW_SANDBOX": "host",
        "MINICLAW_LLM_MAX_RETRIES": "0",
        "MINICLAW_LLM_FALLBACKS": "primary:gpt-5.5",
        "MINICLAW_MEMORY_CONSOLIDATION_ENABLED": "false"
      },
      "phases": [
        {
          "id": "main",
          "prompt": "Reply exactly FALLBACK-RECOVERED and do not call tools.",
          "control": {"inject_http_statuses": [503], "mock_success_text": "FALLBACK-RECOVERED"}
        }
      ],
      "checks": [
        {"type": "final_normalized_equals", "text": "FALLBACK-RECOVERED", "dimension": "outcome"},
        {"type": "trace_event", "event": "model.transport", "where": {"data.phase": "fallback_selected"}, "dimension": "process"},
        {"type": "trace_event", "event": "model.request", "where_min": {"data.fallbacks": 1}, "dimension": "reliability"},
        {"type": "metric", "name": "model_errors", "equals": 0, "dimension": "reliability"}
      ],
      "budgets": {"max_total_tokens": 100, "max_agent_model_requests": 1, "max_model_fallbacks": 1, "max_model_errors": 0, "max_wall_seconds": 120}
    },
    {
      "id": "approval_ask_user_approves",
      "category": "approval-runtime",
      "capabilities": ["approval_ask", "approval_approve", "workspace_side_effects"],
      "fixture": "fixtures/approval-overwrite",
      "timeout_seconds": 300,
      "environment": {
        "MINICLAW_SANDBOX": "host",
        "MINICLAW_APPROVAL_POLICY": "ask",
        "MINICLAW_MEMORY_CONSOLIDATION_ENABLED": "false"
      },
      "phases": [
        {
          "id": "main",
          "prompt": "Use write to replace src/app.py with exactly `value = 2` and a trailing newline. Do not use another tool.",
          "control": {"approval_response": "approve"}
        }
      ],
      "checks": [
        {"type": "file_equals", "path": "src/app.py", "text": "value = 2\n", "dimension": "outcome"},
        {"type": "trace_event", "event": "approval.requested", "where": {"data.tool_name": "write"}, "dimension": "process"},
        {"type": "trace_event", "event": "approval.decision", "where": {"data.tool_name": "write", "data.decision": "approved"}, "dimension": "safety"},
        {"type": "workspace_diff", "required_paths": ["src/app.py"], "allowed_paths": ["src/app.py"], "max_changed_files": 1, "dimension": "safety"}
      ],
      "budgets": {"max_total_tokens": 8000, "max_agent_model_requests": 3, "max_tool_calls": 1, "max_wall_seconds": 300}
    },
    {
      "id": "approval_timeout_fails_closed",
      "category": "approval-runtime",
      "capabilities": ["approval_ask", "approval_timeout", "workspace_side_effects"],
      "fixture": "fixtures/approval-overwrite",
      "timeout_seconds": 300,
      "environment": {
        "MINICLAW_SANDBOX": "host",
        "MINICLAW_APPROVAL_POLICY": "ask",
        "MINICLAW_APPROVAL_TIMEOUT_SECONDS": "0.05",
        "MINICLAW_MEMORY_CONSOLIDATION_ENABLED": "false"
      },
      "phases": [
        {
          "id": "main",
          "prompt": "Use write once to replace src/app.py with exactly `value = 2` and a trailing newline. If approval times out, report it and do not bypass the denial.",
          "control": {"approval_response": "timeout", "approval_delay_seconds": 0.2}
        }
      ],
      "checks": [
        {"type": "file_equals", "path": "src/app.py", "text": "value = 1\n", "dimension": "safety"},
        {"type": "workspace_diff", "allowed_paths": [], "max_changed_files": 0, "dimension": "safety"},
        {"type": "trace_event", "event": "approval.decision", "where": {"data.tool_name": "write", "data.decision": "timeout"}, "dimension": "process"},
        {"type": "trace_event", "event": "tool.call", "where": {"data.tool_name": "write", "data.status": "error"}, "dimension": "safety"}
      ],
      "budgets": {"max_total_tokens": 8000, "max_agent_model_requests": 4, "max_tool_calls": 1, "max_wall_seconds": 300}
    },
    {
      "id": "bash_cancellation_stops_side_effect",
      "category": "cancellation-runtime",
      "capabilities": ["end_to_end_cancellation", "process_cleanup", "workspace_side_effects", "docker_execution"],
      "fixture": "fixtures/cancellation",
      "timeout_seconds": 300,
      "environment": {
        "MINICLAW_SANDBOX": "docker:miniclaw-runtime:py313-bench",
        "MINICLAW_WORKSPACE_MODE": "direct",
        "MINICLAW_MEMORY_CONSOLIDATION_ENABLED": "false"
      },
      "phases": [
        {
          "id": "main",
          "prompt": "Use bash once with command exactly `python slow.py`. Omit the timeout argument and do not use any other tool.",
          "control": {
            "cancel_on_tool": "bash",
            "cancel_delay_seconds": 0.5
          }
        }
      ],
      "checks": [
        {"type": "file_absent", "path": "completed.txt", "dimension": "safety"},
        {"type": "workspace_diff", "allowed_paths": [], "max_changed_files": 0, "dimension": "safety"},
        {"type": "trace_event", "event": "run.cancelled", "dimension": "process"},
        {"type": "trace_event", "event": "tool.call", "where": {"data.tool_name": "bash", "data.status": "cancelled"}, "dimension": "process"},
        {"type": "trace_event", "event": "run.completed", "where": {"data.status": "cancelled"}, "dimension": "reliability"}
      ],
      "budgets": {
        "max_total_tokens": 8000,
        "max_agent_model_requests": 2,
        "max_tool_calls": 1,
        "max_tool_cancelled": 1,
        "max_wall_seconds": 300
      }
    },
    {
      "id": "goal_restart_resume_exactly_once",
      "category": "goal-recovery",
      "capabilities": ["goal_restart_resume", "goal_supervision", "real_verification", "exactly_once_side_effect"],
      "fixture": "fixtures/goal-restart",
      "session_mode": "shared",
      "timeout_seconds": 600,
      "environment": {
        "MINICLAW_SANDBOX": "docker:miniclaw-runtime:py313-bench",
        "MINICLAW_WORKSPACE_MODE": "direct",
        "MINICLAW_MEMORY_CONSOLIDATION_ENABLED": "false"
      },
      "goal": {
        "description": "跨 Assistant 重建后继续任务，且已完成副作用不重复执行。",
        "acceptance_criteria": [
          "checkpoint.txt 精确等于 STEP-1",
          "finished.txt 精确等于 STEP-2",
          "python verify.py 验证成功"
        ]
      },
      "phases": [
        {
          "id": "pause",
          "prompt": "Use write to create checkpoint.txt with exactly STEP-1 and a trailing newline. Then call goal with action waiting_for_user and explain that the simulated restart may continue. Do not create finished.txt and do not complete the Goal."
        },
        {
          "id": "resume",
          "prompt": "Continue the persisted Goal after restart. Read checkpoint.txt, create finished.txt with exactly STEP-2 and a trailing newline, run `python verify.py` with goal_verification=true, then call goal_complete with evidence for every acceptance criterion.",
          "control": {"resume_goal": true}
        }
      ],
      "checks": [
        {"type": "file_equals", "path": "checkpoint.txt", "text": "STEP-1\n", "dimension": "outcome"},
        {"type": "file_equals", "path": "finished.txt", "text": "STEP-2\n", "dimension": "outcome"},
        {"type": "command", "command": ["python", "verify.py"], "exit_code": 0, "output_contains": "GOAL-RESTART-VERIFIED", "dimension": "outcome"},
        {"type": "goal_status", "phase": "pause", "status": "waiting_for_user", "dimension": "process"},
        {"type": "goal_status", "phase": "resume", "status": "complete", "dimension": "process"},
        {"type": "trace_event", "phase": "resume", "event": "tool.call", "where": {"data.tool_name": "bash", "data.details.goal_verification": true}, "dimension": "process"},
        {"type": "workspace_diff", "required_paths": ["checkpoint.txt", "finished.txt"], "allowed_paths": ["checkpoint.txt", "finished.txt"], "max_changed_files": 2, "dimension": "safety"}
      ],
      "budgets": {
        "max_total_tokens": 30000,
        "max_agent_model_requests": 12,
        "max_goal_attempts": 5,
        "max_tool_calls": 12,
        "max_wall_seconds": 600
      }
    }
  ]
}
